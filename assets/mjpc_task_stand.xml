<mujoco>
  <custom>
    <!-- Planner 0 = Sampling, 2 = iLQR -->
    <numeric name="agent_planner"          data="0" />
    <numeric name="agent_horizon"          data="1.0" />
    <numeric name="agent_timestep"         data="0.005" />
    
    <!-- sampling planner only -->
    <numeric name="sampling_spline_points" data="5" />
    <numeric name="sampling_exploration"   data="0.15" />
    <numeric name="sampling_trajectories" data="46" />
  
    <!-- ilqr planner only-->
    <numeric name="gradient_spline_points" data="3" />

    <!-- Height goal: target head-to-feet distance in metres -->
    <numeric name="residual_Height Goal"   data="1.8 0.0 2.0" />
  </custom>

  <sensor>
    <!-- === MJPC User-Sensor Residual Terms ===
         Dims matched to winter_baseline_male.xml: nq=32, nv=31, nu=21
         Posture (nq-7=25), Joint Vel. (nv-6=25), Control (nu=21). -->

    <!-- Residual 0: head-feet height error (scalar) -->
    <user name="Height"     dim="1"  user="6 100.0 0.0 100.0 0.1" />
    <!-- Residual 1: CoM-feet XY balance distance (scalar) -->
    <user name="Balance"    dim="1"  user="6 10.0  0.0 100.0 0.1" />
    <!-- Residual 2: CoM XY velocity should be zero (2D) -->
    <user name="CoM Vel."   dim="2"  user="0 50.0  0.0 100.0" />
    <!-- Residual 3: joint velocity minimisation (nv-6 = 25) -->
    <user name="Joint Vel." dim="25" user="0 0.05  0.0 0.1" />
    <!-- Residual 4: actuator effort minimisation (nu = 21) -->
    <user name="Control"    dim="21" user="6 0.01 0.0 0.1 0.3" />

    <!-- === Kinematic sensors required by Stand::ResidualFn === -->

    <!-- Foot-sole support polygon sites (sp0-sp3 defined in humanoid XML) -->
    <framepos name="sp0" objtype="site" objname="sp0"/>
    <framepos name="sp1" objtype="site" objname="sp1"/>
    <framepos name="sp2" objtype="site" objname="sp2"/>
    <framepos name="sp3" objtype="site" objname="sp3"/>

    <!-- Head and torso position/velocity for residual computation -->
    <framepos      name="head_position"      objtype="body" objname="head"/>
    <subtreecom    name="torso_subtreecom"    body="torso"/>
    <subtreelinvel name="torso_subtreelinvel" body="torso"/>

    <!-- Auxiliary sensors for tracing/rendering -->
    <framepos      name="torso_position"  objtype="body"  objname="torso"/>
    <framezaxis    name="torso_zaxis"     objtype="xbody" objname="torso"/>
    <framexaxis    name="torso_forward"   objtype="xbody" objname="torso"/>
    <subtreelinvel name="foot_right_vel"  body="foot_right"/>
    <subtreelinvel name="foot_left_vel"   body="foot_left"/>
    <framepos      name="trace0"          objtype="body"  objname="torso"/>
  </sensor>
</mujoco>
